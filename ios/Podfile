# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Keep the New Architecture disabled to match Android's newArchEnabled=false
# in android/gradle.properties. Without this, RN 0.81's Podfile helpers
# default RCT_NEW_ARCH_ENABLED to true, which enables Fabric/bridgeless-style
# JS module registration on iOS only — incompatible with native modules
# (e.g. react-native-track-player) still built on the legacy RCTEventEmitter
# bridge, causing a "RCTEventEmitter.receiveEvent ... not registered as
# callable" crash on launch.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, '16.0' # @react-native-community/netinfo requires iOS 14.0+
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'GhanaTalksRadio' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'GhanaTalksRadioTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # installer.pods_project.targets.each do |target|
    #   target.build_configurations.each do |config|
    #     config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    #   end
    # end

    # Xcode 26's Clang (21) enables fmt's C++20 `consteval` codepath, which is
    # broken there and fails FMT_STRING expansions with "call to consteval
    # function ... is not a constant expression". fmt's own Apple-clang
    # version gate (base.h) predates clang 21, so it doesn't catch this.
    # Force FMT_USE_CONSTEVAL off unconditionally on Apple clang until an
    # upstream fmt/RN bump fixes this. See fmtlib/fmt#4740.
    fmt_base_h = File.join(installer.sandbox.pod_dir('fmt'), 'include/fmt/base.h')
    if File.exist?(fmt_base_h)
      contents = File.read(fmt_base_h)
      patched = contents.sub(
        /#elif defined\(__apple_build_version__\) && __apple_build_version__ < \d+L\n#  define FMT_USE_CONSTEVAL 0.*\n/,
        "#elif defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang (incl. Xcode 26 / clang 21).\n"
      )
      File.write(fmt_base_h, patched) if patched != contents
    end
  end
end
